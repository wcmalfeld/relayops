# ---------------------------------------------------------------------------
# RelayOps configuration. Copy to .env.local for local development.
# Never commit real secrets.
# ---------------------------------------------------------------------------

# Runtime connection: the restricted role (NOSUPERUSER, NOBYPASSRLS).
DATABASE_URL=postgres://relayops_app:relayops_app_dev@localhost:5432/relayops
# Owner connection: used only by migrations and seed scripts.
DATABASE_ADMIN_URL=postgres://relayops_owner:relayops_owner_dev@localhost:5432/relayops
# Local superuser, used once by `npm run db:setup` to create roles/databases.
PG_SUPERUSER_URL=postgres://postgres:postgres@localhost:5432/postgres

# Separate database for integration and end-to-end tests (reset on every run).
TEST_DATABASE_URL=postgres://relayops_app:relayops_app_dev@localhost:5432/relayops_test
TEST_DATABASE_ADMIN_URL=postgres://relayops_owner:relayops_owner_dev@localhost:5432/relayops_test

APP_URL=http://localhost:3000
# 32+ random characters. Generate with: openssl rand -base64 48
AUTH_SECRET=dev-only-change-me-0123456789abcdefghijklmnopqrstuvwxyz
SESSION_TTL_HOURS=168

# AI provider: mock | anthropic | openai | unavailable
#   mock         deterministic local provider, no credentials needed
#   unavailable  simulates a provider outage (manual workflow keeps working)
AI_PROVIDER=mock
# AI_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=25000
AI_MAX_RETRIES=2
AI_MAX_INPUT_CHARS=6000
AI_RUNS_PER_HOUR=120
# Log full prompts to the server console. Leave false outside local debugging.
AI_LOG_PROMPTS=false

# Customer message delivery. Only the simulated adapter exists in this MVP.
DELIVERY_PROVIDER=mock

PUBLIC_INTAKE_PER_HOUR=10
API_INTAKE_PER_MINUTE=60
LOGIN_ATTEMPTS_PER_15_MIN=10

# Bearer secret for GET /api/cron/unresolved (Vercel Cron sends it automatically). Leave unset to disable.
# CRON_SECRET=

# Connection pool size per server instance. Keep small on serverless hosts.
# DATABASE_POOL_MAX=10

# End-to-end tests: path to an existing Chromium/Chrome, if you do not want to
# run `npx playwright install chromium`.
# PLAYWRIGHT_CHROMIUM_PATH=
